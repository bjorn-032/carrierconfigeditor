<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TargetFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <RadioGroup
                    android:id="@+id/sub_selection"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <RadioButton
                        android:id="@+id/sub1_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="SIM-Slot 1" />

                    <RadioButton
                        android:id="@+id/sub2_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SIM-Slot 2" />

                </RadioGroup>

                <Button
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:id="@+id/button_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:text="Reset" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_force_home_network"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Force Home Network"
                    android:layout_marginVertical="8dp"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_carrier_aggregation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Hide Carrier Aggregation (4G+)"
                    android:layout_marginVertical="8dp"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_video_calling"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Show video calling option in settings"
                    android:layout_marginVertical="8dp"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_prefer_2g"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Show 2G option in settings"
                    android:layout_marginVertical="8dp"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_spn_display_service_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="SPN Display rule use roaming from service state"
                    android:layout_marginVertical="8dp"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_name_resolver"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Enable carrier display name resolver"
                    android:layout_marginVertical="8dp"
                    android:textSize="15sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_empty_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Set empty name"
                    android:layout_marginVertical="8dp"
                    android:textSize="15sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_spn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SPN display condition"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="Determine when the SPN or PLMN should be shown"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_signal_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LTE signal bar configuration"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textView13"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="Configure how signal bars show RSRP (Reference Signal Received Power), RSRQ (Reference Signal Received Quality) and RSSNR (Reference Signal Signal to Noise Ratio)."
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_upload"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import roaming config"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="Import a file which contains settings for which carriers and/or countries should be treated as roaming/non-roaming"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View roaming networks"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="View the list of countries and networks which will be considered roaming/non-roaming."
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_ehplmn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configure EHPLMN"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="Configure the list of PLMN's that will override the list of Equivalent Home PLMN's."
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_oplmn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configure Operator PLMN"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="Configure the list of PLMN's that will override the list of Operator PLMN's."
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/list_carrier_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textView14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Custom carrier name"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textView15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="Configure a custom PLMN name."
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>